# Copy this file to .env.postgres.local or run scripts/setup_postgres.ps1.
# Never commit the real password or worker credential key.
TOOLIB_POSTGRES_DB=toolib
TOOLIB_POSTGRES_USER=toolib
TOOLIB_POSTGRES_PASSWORD=replace-with-a-long-random-password
TOOLIB_POSTGRES_PORT=54329
YOLO_LABELING_DB_URI=postgresql+psycopg://toolib:replace-with-a-long-random-password@127.0.0.1:54329/toolib

# Production must provide this from a secret manager. The local proof flow can
# continue using instance/worker_credential.key generated by the application.
# TOOLIB_WORKER_CREDENTIAL_KEY=
